# External API Keys (all optional - dashboard works without them)

# NASA FIRMS - for wildfire hotspot data
# Get free key at: https://firms.modaps.eosdis.nasa.gov/api/area/
NASA_FIRMS_API_KEY=

# Twilio - for SMS alerts
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# SendGrid - for email alerts
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Google Cloud Translation
GOOGLE_TRANSLATE_API_KEY=

# Server config
PORT=5000
CLIENT_URL=http://localhost:5173
