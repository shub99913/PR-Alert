# PR-Alert Backend Environment Variables
# Copy this file to .env and fill in your values

# Server
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173

# MongoDB - Use local or Atlas
# Local: MONGODB_URI=mongodb://localhost:27017/disaster-dashboard
# Atlas: MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/disaster-dashboard?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/disaster-dashboard

# Redis (for BullMQ - optional, defaults to localhost)
REDIS_URL=redis://localhost:6379

# External APIs (optional - for full functionality)
USGS_EARTHQUAKE_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_hour.geojson
GDACS_API_URL=https://www.gdacs.org/gdacsapi/api/events/geteventlist/SEARCH

# OpenWeatherMap (get key at https://openweathermap.org/api)
OPENWEATHER_API_KEY=
OPENWEATHER_API_URL=https://api.openweathermap.org/data/2.5

# Twilio SMS (get at https://www.twilio.com/)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# SendGrid Email (get at https://sendgrid.com/)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=alerts@pr-alert.org
SENDGRID_FROM_NAME=PR-Alert System

# Firebase Cloud Messaging (get at https://firebase.google.com/)
FCM_PROJECT_ID=
FCM_SERVER_KEY=

# WhatsApp Business API (get at https://developers.facebook.com/)
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# SACHET/C-DOT Integration (requires government authorization)
SACHET_API_URL=
SACHET_API_KEY=
CAP_SENDER_ID=PR-ALERT

# Feature Flags
ENABLE_REAL_DISPATCH=false
ENABLE_ML_INFERENCE=false
ENABLE_CROWD_REPORTS=true

# Logging
LOG_LEVEL=info